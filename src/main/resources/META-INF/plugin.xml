<idea-plugin>
    <version>1.0.2</version>

    <id>javiergs.pcode-intellij-plugin</id>
    <name>P-Code VM</name>
    <vendor>JGS Labs</vendor>

    <description><![CDATA[
    <h2>P-Code VM</h2>
    <p>
    Educational virtual machine and debugger for IntelliJ IDEA.
    </p>
    <h3>Features</h3>
    <ul>
    <li>P-Code syntax highlighting</li>
    <li>Step-by-step VM execution</li>
    <li>Stack visualization</li>
    <li>Symbol table inspection</li>
    <li>Call stack tracking</li>
    <li>Runtime frame visualization</li>
    <li>Method calls and recursion support</li>
    </ul>
    <p>
    Designed for compiler construction and programming language courses.
    </p>
    ]]></description>

    <change-notes><![CDATA[
    <ul>
    <li>Initial release of the P-Code VM plugin.</li>
    <li>Added P-Code syntax highlighting.</li>
    <li>Added VM execution and debugger console.</li>
    <li>Added register stack, symbol table, call stack, and runtime frame visualization.</li>
    <li>Added support for method calls, recursion, and return values.</li>
    </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">

        <toolWindow
                id="P-Code Console"
                factoryClass="javiergs.pcode.PCodeConsoleFactory"
                anchor="bottom"/>

        <fileType
                name="P-Code VM File"
                language="PCode"
                implementationClass="javiergs.pcode.PCodeFileType"
                fieldName="INSTANCE"
                extensions="pcode"/>

        <lang.syntaxHighlighterFactory
                language="PCode"
                implementationClass="javiergs.pcode.PCodeSyntaxHighlighterFactory"/>
    </extensions>

    <actions>
        <action
                id="RunPCodeAction"
                class="javiergs.pcode.RunPCodeAction"
                text="Execute P-Code"
                description="Execute P-Code Program">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="F5"/>
        </action>
        <action
                id="StepPCodeAction"
                class="javiergs.pcode.StepPCodeAction"
                text="Step P-Code"
                description="Execute one P-Code instruction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="F10"/>
        </action>
    </actions>


    <projectListeners>
        <listener
                class="javiergs.pcode.PCodeFileEditorListener"
                topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

</idea-plugin>
